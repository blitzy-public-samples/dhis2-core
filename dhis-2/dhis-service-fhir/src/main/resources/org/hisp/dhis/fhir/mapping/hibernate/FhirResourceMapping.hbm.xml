<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
  "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd"
  [<!ENTITY identifiableProperties SYSTEM "classpath://org/hisp/dhis/common/identifiableProperties.hbm">]
  >

<hibernate-mapping>
  <typedef class="org.hisp.dhis.hibernate.jsonb.type.JsonListBinaryType" name="jlbFhirFieldMappings">
    <param name="clazz">org.hisp.dhis.fhir.mapping.FhirFieldMapping</param>
  </typedef>

  <class name="org.hisp.dhis.fhir.mapping.FhirResourceMapping" table="fhirresourcemapping">

    <cache usage="read-write" />

    <id name="id" column="fhirresourcemappingid">
      <generator class="native" />
    </id>
    &identifiableProperties;

    <property name="name" column="name" not-null="true" unique="true" length="230" />

    <many-to-one name="createdBy" class="org.hisp.dhis.user.User" column="userid" foreign-key="fk_fhirresourcemapping_userid" />

    <property name="translations" column="translations" type="jblTranslations" />

    <property name="sharing" column="sharing" type="jsbObjectSharing" />

    <property name="attributeValues" column="attributevalues" type="jsbAttributeValues" />

    <property name="resourceType" column="resourcetype" length="50" not-null="true">
      <type name="org.hibernate.type.EnumType">
        <param name="enumClass">org.hisp.dhis.fhir.mapping.FhirResourceType</param>
        <param name="useNamed">true</param>
        <param name="type">12</param>
      </type>
    </property>

    <many-to-one name="trackedEntityType" class="org.hisp.dhis.trackedentity.TrackedEntityType" column="trackedentitytypeid" not-null="true" foreign-key="fk_fhirresourcemapping_trackedentitytypeid" />

    <many-to-one name="program" class="org.hisp.dhis.program.Program" column="programid" foreign-key="fk_fhirresourcemapping_programid" />

    <many-to-one name="programStage" class="org.hisp.dhis.program.ProgramStage" column="programstageid" foreign-key="fk_fhirresourcemapping_programstageid" />

    <property name="fieldMappings" column="fieldmappings" type="jlbFhirFieldMappings" not-null="true" />

  </class>

</hibernate-mapping>
